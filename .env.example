# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Public site URL (no trailing path). Used for /api/site-link and cookies behind a proxy.
# Production example: https://lab.example.uz
PUBLIC_URL=http://127.0.0.1:3000

# PostgreSQL (Supabase Session pooler URI, include sslmode=require)
# Example shape only — replace PROJECT-REF, REGION, and the password yourself:
# postgresql://postgres.PROJECT-REF:[YOUR-DB-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT-REF:[YOUR-DB-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Random 32+ character string. Changing it invalidates sessions and encrypted Telegram tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure flag. Set true on HTTPS production.
COOKIE_SECURE=false

# Trust the first proxy (nginx, Railway, Render). Set true in production.
TRUST_PROXY=false

# Created only if those usernames do not exist yet. Do not reuse old demo passwords.
# Minimum 12 characters.
INITIAL_ADMIN_PASSWORD=
INITIAL_DIRECTOR_PASSWORD=
INITIAL_WORKER_PASSWORD=

# Optional: store a new Telegram bot token here instead of the admin UI.
# Leave empty and paste a ROTATED token in Sozlamalar after deploy.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs that may broadcast announcements via the bot.
# Comma-separated. Usernames are ignored. Used by serve.ps1 polling listener.
# Example: TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=
