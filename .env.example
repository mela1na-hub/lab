# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Public site URL (no trailing path). Used for /api/site-link and cookies behind a proxy.
# Production example: https://lab.example.uz
PUBLIC_URL=http://127.0.0.1:3000

# SQLite file (created automatically).
SQLITE_PATH=data/app.sqlite

# Random 32+ character string. Changing it invalidates sessions and encrypted Telegram tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure flag. Set true on HTTPS production.
COOKIE_SECURE=false

# Trust the first proxy (nginx, Railway, Render). Set true in production.
TRUST_PROXY=false

# Optional: store a new Telegram bot token here instead of the admin UI.
# Leave empty and paste a token in Sozlamalar after deploy.
TELEGRAM_BOT_TOKEN=
